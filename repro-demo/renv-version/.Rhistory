matched_data$is_SM == TRUE & matched_data$Analysis_Group == "Control"
] <- "SM"
matched_data$Compare_Group[
matched_data$Analysis_Group == "Undisclosed"
] <- "Undisclosed"
sub_compare <- matched_data[!is.na(matched_data$Compare_Group), ]
table(sub_compare$Compare_Group)
love.plot(m.out, abs = TRUE, thresholds = c(m = 0.1))
love.plot(m.out, abs = TRUE, thresholds = c(m = 0.1))
model <- BuyseTest::BuyseTest(
data = matched_data,
treatment = "Analysis_Group",
endpoint = endpoints,
operator = operators,
type = types,
method.inference = "u-statistic",
trace = 0
)
res <- BuyseTest::confint(model, statistic = "winRatio")
res
sum_obj <- BuyseTest::summary(model)
sum_obj$table.endpoint
library(BuyseTest)
fav   <- coef(model, statistic = "favorable",   stratified = FALSE, cumulative = FALSE)
unfav <- coef(model, statistic = "unfavorable", stratified = FALSE, cumulative = FALSE)
neu   <- coef(model, statistic = "neutral",     stratified = FALSE, cumulative = FALSE)
uninf <- coef(model, statistic = "uninf",       stratified = FALSE, cumulative = FALSE)
delta_now <- coef(model, statistic = "netBenefit", stratified = FALSE, cumulative = FALSE)
Delta_cum <- coef(model, statistic = "netBenefit", stratified = FALSE, cumulative = TRUE)
ep <- data.frame(
endpoint = names(fav),
favorable = as.numeric(fav),
unfavorable = as.numeric(unfav),
neutral = as.numeric(neu),
uninf = as.numeric(uninf),
delta = as.numeric(delta_now),
Delta = as.numeric(Delta_cum)
)
if (max(ep$favorable, ep$unfavorable, ep$neutral, ep$uninf, na.rm = TRUE) <= 1) {
ep <- ep %>%
mutate(
favorable = favorable * 100,
unfavorable = unfavorable * 100,
neutral = neutral * 100,
uninf = uninf * 100
)
}
ep <- ep %>%
mutate(
total = favorable + unfavorable + neutral + uninf
)
ep
wr <- as.data.frame(res)
wr
last <- nrow(wr)
wr_est  <- wr[last, "estimate"]
wr_low  <- wr[last, "lower.ci"]
wr_high <- wr[last, "upper.ci"]
wr_p    <- wr[last, "p.value"]
run_custom_comparison_psm <- function(
data,
treat_cond,
control_cond,
label,
filter_cond = TRUE,
ps_covars,
match_ratio = 2,
caliper = 0.2,
replace = FALSE
) {
# ==========================================================================
# 1. 动态筛选数据（与你原函数一致）
# ==========================================================================
treat_expr <- substitute(treat_cond)
ctrl_expr  <- substitute(control_cond)
filt_expr  <- substitute(filter_cond)
idx_treat   <- eval(treat_expr, data, parent.frame())
idx_control <- eval(ctrl_expr,  data, parent.frame())
raw_filter  <- eval(filt_expr,  data, parent.frame())
if (length(raw_filter) == 1 && is.logical(raw_filter) && raw_filter == TRUE) {
idx_filter <- rep(TRUE, nrow(data))
} else {
idx_filter <- raw_filter
}
keep_rows <- idx_filter & (idx_treat | idx_control)
keep_rows[is.na(keep_rows)] <- FALSE
if (sum(keep_rows) == 0) return(NULL)
sub_data <- data[keep_rows, , drop = FALSE]
# 分组标签（与你原逻辑一致）
sub_treat_check <- eval(treat_expr, sub_data, parent.frame())
sub_data$Analysis_Group <- ifelse(sub_treat_check, "Undisclosed", "Control")
counts <- table(sub_data$Analysis_Group)
if (length(counts) < 2 || min(counts) < 5) return(NULL)
# ==========================================================================
# 2. PSM：Propensity Score Matching
# ==========================================================================
# 2.1 协变量检查
miss_cov <- setdiff(ps_covars, names(sub_data))
if (length(miss_cov) > 0) {
stop("Missing PS covariates: ", paste(miss_cov, collapse = ", "))
}
# 2.2 去除 PS 协变量缺失
sub_ps <- sub_data %>%
filter(if_all(all_of(ps_covars), ~ !is.na(.x))) %>%
mutate(
Analysis_Group = factor(Analysis_Group,
levels = c("Control", "Undisclosed"))
)
counts_ps <- table(sub_ps$Analysis_Group)
if (length(counts_ps) < 2 || min(counts_ps) < 5) return(NULL)
# 2.3 PS 模型 + 匹配
ps_formula <- as.formula(
paste("Analysis_Group ~", paste(ps_covars, collapse = " + "))
)
m.out <- matchit(
formula  = ps_formula,
data     = sub_ps,
method   = "nearest",
distance = "logit",
ratio    = match_ratio,
caliper  = caliper,
replace  = replace
)
matched_data <- match.data(m.out)
counts_m <- table(matched_data$Analysis_Group)
if (length(counts_m) < 2 || min(counts_m) < 5) return(NULL)
n_control <- as.integer(counts_m["Control"])
n_treat   <- as.integer(counts_m["Undisclosed"])
# ==========================================================================
# 3. Balance diagnostics（必须做，但不影响 WR 计算）
# ==========================================================================
bal_tab <- cobalt::bal.tab(m.out, un = TRUE)
# 如需画图（不强制）
love_plot <- cobalt::love.plot(
m.out,
abs = TRUE,
thresholds = c(m = 0.1)
)
# ==========================================================================
# 4. Win Ratio（完全保留你原来的计算逻辑）
# ==========================================================================
endpoints <- c("v_SBQ", "v_NSSI", "v_PHQ", "v_GAD")
operators <- rep("<0", 4)     # 0=good, 1=bad
types     <- rep("binary", 4)
model <- BuyseTest::BuyseTest(
data = matched_data,
treatment = "Analysis_Group",
endpoint = endpoints,
operator = operators,
type = types,
method.inference = "u-statistic",
trace = 0
)
# --- Summary ---
res_nb <- BuyseTest::confint(model, statistic = "winRatio")
last <- nrow(res_nb)
summary_row <- data.frame(
Comparison = label,
N_Control  = n_control,
N_Treat    = n_treat,
Win_Ratio = round(res_nb[last, "estimate"], 3),   # Winratio
CI_Lower   = round(res_nb[last, "lower.ci"], 3),
CI_Upper   = round(res_nb[last, "upper.ci"], 3),
P_Value    = sprintf("%.4f", res_nb[last, "p.value"]),
Note       = ifelse(res_nb[last, "p.value"] < 0.05, "显著", "")
)
# --- Detailed endpoint table ---
sum_obj <- BuyseTest::summary(model)
if (!is.null(sum_obj$table.endpoint)) {
detail_raw <- as.data.frame(sum_obj$table.endpoint)
detail_row <- data.frame(
Comparison_Group = label,
Endpoint = detail_raw$endpoint,
Win_Percent = round(detail_raw$favorable, 2),
Loss_Percent = round(detail_raw$unfavorable, 2),
Neutral_Percent = round(detail_raw$neutral, 2),
Net_Benefit = round(detail_raw$Delta, 4),
P_Value = sprintf("%.4f", detail_raw$p.value)
)
} else {
detail_row <- data.frame(Comparison_Group = label, Note = "详细数据提取失败")
}
return(list(
summary  = summary_row,
details  = detail_row,
balance  = bal_tab,
matchit  = m.out
))
}
all_summaries <- list()
all_details   <- list()
all_matchits  <- list()
store_result <- function(res) {
if (!is.null(res)) {
all_summaries[[length(all_summaries) + 1]] <<- res$summary
if (!is.null(res$details)) {
all_details[[length(all_details) + 1]] <<- res$details
}
if (!is.null(res$matchit)) {
all_matchits[[length(all_matchits) + 1]] <<- res$matchit
}
}
}
message(">>> 开始批量分析 (PSM + Win Ratio, Binary Mode)...")
# Group 1
store_result(run_custom_comparison_psm(
clean_data, is_Undisclosed, is_Disclosed,
"1.1 总体: 愿意回答 vs 不愿回答",
ps_covars = ps_covars
))
# Group 2
store_result(run_custom_comparison_psm(
clean_data, is_Undisclosed, is_Disclosed,
"2.1 男性: 愿意回答 vs 不愿回答",
filter_cond = (Sex == 1),
ps_covars = ps_covars
))
store_result(run_custom_comparison_psm(
clean_data, is_Undisclosed, is_Disclosed,
"2.2 女性: 愿意回答 vs 不愿回答",
filter_cond = (Sex == 2),
ps_covars = ps_covars
))
# Group 3
store_result(run_custom_comparison_psm(
clean_data, is_Undisclosed, is_Hetero,
"3.1 异性恋 vs 不愿回答",
ps_covars = ps_covars
))
store_result(run_custom_comparison_psm(
clean_data, is_Undisclosed, is_SM,
"3.2 性少数 vs 不愿回答",
ps_covars = ps_covars
))
# Group 4
store_result(run_custom_comparison_psm(
clean_data, is_Undisclosed, is_Hetero,
"4.1 男性: 异性恋 vs 不愿回答",
filter_cond = (Sex == 1),
ps_covars = ps_covars
))
store_result(run_custom_comparison_psm(
clean_data, is_Undisclosed, is_Hetero,
"4.2 女性: 异性恋 vs 不愿回答",
filter_cond = (Sex == 2),
ps_covars = ps_covars
))
store_result(run_custom_comparison_psm(
clean_data, is_Undisclosed, is_SM,
"4.3 男性: 性少数 vs 不愿回答",
filter_cond = (Sex == 1),
ps_covars = ps_covars
))
store_result(run_custom_comparison_psm(
clean_data, is_Undisclosed, is_SM,
"4.4 女性: 性少数 vs 不愿回答",
filter_cond = (Sex == 2),
ps_covars = ps_covars
))
# 合并输出表
summary_table_wr <- dplyr::bind_rows(all_summaries)
detail_table_wr  <- dplyr::bind_rows(all_details)
summary_table_wr
set.seed(20260519)
run_custom_comparison_psm <- function(
data,
treat_cond,
control_cond,
label,
filter_cond = TRUE,
ps_covars,
match_ratio = 2,
caliper = 0.2,
replace = FALSE
) {
# ==========================================================================
# 1. 动态筛选数据（与你原函数一致）
# ==========================================================================
treat_expr <- substitute(treat_cond)
ctrl_expr  <- substitute(control_cond)
filt_expr  <- substitute(filter_cond)
idx_treat   <- eval(treat_expr, data, parent.frame())
idx_control <- eval(ctrl_expr,  data, parent.frame())
raw_filter  <- eval(filt_expr,  data, parent.frame())
if (length(raw_filter) == 1 && is.logical(raw_filter) && raw_filter == TRUE) {
idx_filter <- rep(TRUE, nrow(data))
} else {
idx_filter <- raw_filter
}
keep_rows <- idx_filter & (idx_treat | idx_control)
keep_rows[is.na(keep_rows)] <- FALSE
if (sum(keep_rows) == 0) return(NULL)
sub_data <- data[keep_rows, , drop = FALSE]
# 分组标签（与你原逻辑一致）
sub_treat_check <- eval(treat_expr, sub_data, parent.frame())
sub_data$Analysis_Group <- ifelse(sub_treat_check, "Undisclosed", "Control")
counts <- table(sub_data$Analysis_Group)
if (length(counts) < 2 || min(counts) < 5) return(NULL)
# ==========================================================================
# 2. PSM：Propensity Score Matching
# ==========================================================================
# 2.1 协变量检查
miss_cov <- setdiff(ps_covars, names(sub_data))
if (length(miss_cov) > 0) {
stop("Missing PS covariates: ", paste(miss_cov, collapse = ", "))
}
# 2.2 去除 PS 协变量缺失
sub_ps <- sub_data %>%
filter(if_all(all_of(ps_covars), ~ !is.na(.x))) %>%
mutate(
Analysis_Group = factor(Analysis_Group,
levels = c("Control", "Undisclosed"))
)
counts_ps <- table(sub_ps$Analysis_Group)
if (length(counts_ps) < 2 || min(counts_ps) < 5) return(NULL)
# 2.3 PS 模型 + 匹配
ps_formula <- as.formula(
paste("Analysis_Group ~", paste(ps_covars, collapse = " + "))
)
m.out <- matchit(
formula  = ps_formula,
data     = sub_ps,
method   = "nearest",
distance = "logit",
ratio    = match_ratio,
caliper  = caliper,
replace  = replace
)
matched_data <- match.data(m.out)
counts_m <- table(matched_data$Analysis_Group)
if (length(counts_m) < 2 || min(counts_m) < 5) return(NULL)
n_control <- as.integer(counts_m["Control"])
n_treat   <- as.integer(counts_m["Undisclosed"])
# ==========================================================================
# 3. Balance diagnostics（必须做，但不影响 WR 计算）
# ==========================================================================
bal_tab <- cobalt::bal.tab(m.out, un = TRUE)
# 如需画图（不强制）
love_plot <- cobalt::love.plot(
m.out,
abs = TRUE,
thresholds = c(m = 0.1)
)
# ==========================================================================
# 4. Win Ratio（完全保留你原来的计算逻辑）
# ==========================================================================
endpoints <- c("v_SBQ", "v_NSSI", "v_PHQ", "v_GAD")
operators <- rep("<0", 4)     # 0=good, 1=bad
types     <- rep("binary", 4)
model <- BuyseTest::BuyseTest(
data = matched_data,
treatment = "Analysis_Group",
endpoint = endpoints,
operator = operators,
type = types,
method.inference = "u-statistic",
trace = 0
)
# --- Summary ---
res_nb <- BuyseTest::confint(model, statistic = "netBenefit")
last <- nrow(res_nb)
summary_row <- data.frame(
Comparison = label,
N_Control  = n_control,
N_Treat    = n_treat,
NetBenefit = round(res_nb[last, "estimate"], 3),   # cumulative Delta (global)
CI_Lower   = round(res_nb[last, "lower.ci"], 3),
CI_Upper   = round(res_nb[last, "upper.ci"], 3),
P_Value    = sprintf("%.4f", res_nb[last, "p.value"]),
Note       = ifelse(res_nb[last, "p.value"] < 0.05, "显著", "")
)
# --- Detailed endpoint table ---
sum_obj <- BuyseTest::summary(model)
if (!is.null(sum_obj$table.endpoint)) {
detail_raw <- as.data.frame(sum_obj$table.endpoint)
detail_row <- data.frame(
Comparison_Group = label,
Endpoint = detail_raw$endpoint,
Win_Percent = round(detail_raw$favorable, 2),
Loss_Percent = round(detail_raw$unfavorable, 2),
Neutral_Percent = round(detail_raw$neutral, 2),
Net_Benefit = round(detail_raw$Delta, 4),
P_Value = sprintf("%.4f", detail_raw$p.value)
)
} else {
detail_row <- data.frame(Comparison_Group = label, Note = "详细数据提取失败")
}
return(list(
summary  = summary_row,
details  = detail_row,
balance  = bal_tab,
matchit  = m.out
))
}
all_summaries <- list()
all_details   <- list()
all_matchits  <- list()
store_result <- function(res) {
if (!is.null(res)) {
all_summaries[[length(all_summaries) + 1]] <<- res$summary
if (!is.null(res$details)) {
all_details[[length(all_details) + 1]] <<- res$details
}
if (!is.null(res$matchit)) {
all_matchits[[length(all_matchits) + 1]] <<- res$matchit
}
}
}
